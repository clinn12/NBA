{
  "dataset_family": "historical_league_results",
  "source": "Basketball Reference",
  "start_year": 1960,
  "paths": {
    "standings": "data/published/historical/nba_standings.csv",
    "playoffs": "data/published/historical/nba_playoffs.csv",
    "franchise_lineage": "data/published/historical/franchise_lineage.csv",
