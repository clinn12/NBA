# Python bytecode, caches, coverage, and build products
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Local environments and Jupyter runtime artifacts
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/
.virtual_documents/

# Editors, operating systems, and local agent state
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.code-workspace
.agents/
.codex/

# Secrets and machine-local configuration
.env
.env.*
!.env.example
.secrets/
credentials*.json
secrets*.json

# Logs, temporary files, and editor backups
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# Local databases and serialized model artifacts
*.db
*.sqlite
*.sqlite3
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth

# Reproducible retrieval and publication products. Manifests remain eligible
# for version control because they describe governed dataset contracts.
data/raw/**
data/published/**
data/versions/**
reports/**

# Superseded assets remain available locally without expanding repository size.
**/__Archive__/
